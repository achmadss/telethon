# Get these from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Session storage (mounted volume). Keep this file secret - it grants full
# access to the logged-in Telegram account.
SESSION_DIR=/data
SESSION_NAME=agent

# Optional: simple bearer token required by the HTTP API. Leave empty to disable.
API_TOKEN=
